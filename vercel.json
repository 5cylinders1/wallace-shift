{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/bucyrus-auto",
      "has": [{ "type": "host", "value": "contractors.wallaceshift.com" }],
      "destination": "https://wallaceshift.com/bucyrus-auto",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/bucyrus-auto/:path*",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/demos/bucyrus-auto/:path*",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/resources/blog/wallace-shift-business-systems-worksheets.xlsx",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"wallace-shift-business-systems-worksheets.xlsx\""
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/bucyrus-auto",
      "destination": "/demos/bucyrus-auto"
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "roofers.wallaceshift.com" }],
      "destination": "/demos/roofers-offer"
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "contractors.wallaceshift.com" }],
      "destination": "/demos/contractors"
    },
    {
      "source": "/northvane",
      "destination": "/demos/roofers"
    },
    {
      "source": "/northvane/insurance",
      "destination": "/demos/roofers/insurance"
    },
    {
      "source": "/northvane/prices",
      "destination": "/demos/roofers/prices"
    },
    {
      "source": "/northvane/warranty",
      "destination": "/demos/roofers/warranty"
    },
    {
      "source": "/northvane/faq",
      "destination": "/demos/roofers/faq"
    },
    {
      "source": "/roofing-dashboard",
      "destination": "/demos/roofers-dashboard"
    },
    {
      "source": "/alder-stone",
      "destination": "/demos/roofers-2"
    },
    {
      "source": "/alder-stone/process",
      "destination": "/demos/roofers-2/process"
    },
    {
      "source": "/alder-stone/insurance",
      "destination": "/demos/roofers-2/insurance"
    },
    {
      "source": "/alder-stone/cost",
      "destination": "/demos/roofers-2/cost"
    },
    {
      "source": "/alder-stone/estimate",
      "destination": "/demos/roofers-2/estimate"
    },
    {
      "source": "/contour",
      "destination": "/demos/roofers-3"
    },
    {
      "source": "/halcyon",
      "destination": "/demos/roofers-4"
    },
    {
      "source": "/velar",
      "destination": "/demos/roofers-5"
    },
    {
      "source": "/stratum",
      "destination": "/demos/roofers-6"
    },
    {
      "source": "/datum",
      "destination": "/demos/foundation"
    },
    {
      "source": "/datum/:path*",
      "destination": "/demos/foundation"
    },
    {
      "source": "/tambour",
      "destination": "/demos/cabinetry"
    },
    {
      "source": "/tambour/:path*",
      "destination": "/demos/cabinetry"
    },
    {
      "source": "/stillwater",
      "destination": "/demos/pools"
    },
    {
      "source": "/mitre",
      "destination": "/demos/cabinetry-2"
    }
  ]
}
